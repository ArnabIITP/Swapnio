rules_version = '2';

// Swapnio - Firestore security rules
//
// Design goals:
//  * users are publicly discoverable, but only editable by their owner
//  * reputation (rating / completedSwaps) may only be updated by other users
//    through the rating flow, and only after a *completed* swap session
//  * chat data is only visible to the two participants
//  * curated skills, analytics and the moderation queue are admin-only
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).isAdmin == true;
    }

    function changedKeysOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function changedNoneOf(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Fields on a user's own document that only an admin (isAdmin) or a
    // Cloud Function (admin SDK - bypasses these rules) may change: trust /
    // moderation state and reputation numbers the whole no-show and rating
    // system depends on. `isSelf()` used to grant unrestricted self-write
    // access to the entire document, which meant any signed-up user could
    // set their own `isAdmin: true`, clear `isBanned`, or fabricate a
    // perfect rating/attendance record with one Firestore write. This list
    // is what closes that off while leaving normal profile edits untouched.
    function protectedUserFields() {
      return ['isAdmin', 'isBanned', 'rating', 'ratingsCount', 'completedSwaps',
              'sessionsAttended', 'noShowCount'];
    }

    // The `update` guard above doesn't cover `create` - a brand-new account's
    // very first write could otherwise set isAdmin: true directly, since
    // there's no `resource.data` yet to diff against. Every protected field
    // must be absent or at its safe starting value on creation.
    function createsWithSafeUserDefaults() {
      let data = request.resource.data;
      return (!('isAdmin' in data) || data.isAdmin == false)
        && (!('isBanned' in data) || data.isBanned == false)
        && (!('rating' in data) || data.rating == 0)
        && (!('ratingsCount' in data) || data.ratingsCount == 0)
        && (!('completedSwaps' in data) || data.completedSwaps == 0)
        && (!('sessionsAttended' in data) || data.sessionsAttended == 0)
        && (!('noShowCount' in data) || data.noShowCount == 0);
    }

    // No-show enforcement: someone who repeatedly fails to turn up loses the
    // ability to book more sessions until their record recovers. New accounts
    // (fewer than 3 resolved sessions) always pass, so a single early no-show
    // can't lock anyone out. Recovery is automatic - attending sessions pulls
    // the ratio back above the line.
    function isReliableEnough() {
      let profile = userDoc(uid());
      let attended = profile.get('sessionsAttended', 0);
      let noShows = profile.get('noShowCount', 0);
      return (attended + noShows) < 3 || attended * 2 >= (attended + noShows);
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      // Discoverability: every signed-in user can browse profiles, unless the
      // owner set profileVisibility to 'private' - self and admins can always
      // read. ('matches'-only visibility still needs a client/UI-level check
      // today; enforcing it here would require a cross-collection read on
      // every Discover-feed document and hasn't been done yet.)
      allow read: if isSignedIn() && (
        isSelf(userId)
        || isAdmin()
        || resource.data.get('privacy', {}).get('profileVisibility', 'public') != 'private');
      allow create: if isSelf(userId) && createsWithSafeUserDefaults();
      // The owner may edit their own profile fields, but not the
      // trust/reputation fields in protectedUserFields() - those are
      // admin/Cloud-Function-only. Other users may only touch the aggregate
      // reputation fields written by the rating flow (ratingsCount counts
      // received ratings; completedSwaps counts finished sessions).
      allow update: if (isSelf(userId) && changedNoneOf(protectedUserFields()))
        // Only an OTHER signed-in user (the rater, via the rating flow) may
        // touch these aggregate fields - without the !isSelf() check here,
        // this branch let the owner bypass protectedUserFields() entirely
        // and self-write rating/ratingsCount/completedSwaps directly.
        || (isSignedIn() && !isSelf(userId) && changedKeysOnly(['rating', 'ratingsCount', 'completedSwaps', 'lastUpdated']))
        || isAdmin();
      allow delete: if isSelf(userId) || isAdmin();

      // Per-user preferences (notifications / privacy / appearance).
      match /settings/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    // ---------------------------------------------------------- swipe requests
    match /swipeRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == uid()
        || resource.data.toUserId == uid()
        || isAdmin());
      allow create: if isSignedIn() && request.resource.data.fromUserId == uid();
      allow update: if isSignedIn() && resource.data.toUserId == uid();
      allow delete: if isSignedIn() && (
        resource.data.fromUserId == uid() || resource.data.toUserId == uid());
    }

    // -------------------------------------------------------------- favorites
    match /favorites/{favoriteId} {
      allow read, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }

    // ---------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
      // Any signed-in user may notify another user (request / accepted /
      // rating), but if a senderId is included it must be the caller's own -
      // otherwise anyone could spoof `senderName`/`senderId` to impersonate
      // another user (or "Swapnio Support") in a push notification.
      allow create: if isSignedIn() && request.resource.data.userId is string
        && (!('senderId' in request.resource.data) || request.resource.data.senderId == uid());
    }

    // ------------------------------------------------------ chat rooms & chat
    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && uid() in resource.data.users;
      allow create: if isSignedIn() && uid() in request.resource.data.users;
      allow update: if isSignedIn() && uid() in resource.data.users;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.users;
        allow create: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.users
          && request.resource.data.senderId in [uid(), 'system'];
        // Participants may react to messages, but only touch the reactions
        // map - the text, sender and timestamp stay immutable.
        allow update: if isAdmin() || (isSignedIn()
          && uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.users
          && changedKeysOnly(['reactions']));
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------- ratings / swap reviews
    // A rating is only accepted for a *completed* swap the rater took part in.
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == uid()
        && request.resource.data.toUserId != uid()
        && request.resource.data.swapId is string
        && exists(/databases/$(database)/documents/swaps/$(request.resource.data.swapId))
        && uid() in get(/databases/$(database)/documents/swaps/$(request.resource.data.swapId)).data.participants
        && get(/databases/$(database)/documents/swaps/$(request.resource.data.swapId)).data.status == 'completed';
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------- swap sessions
    match /swaps/{swapId} {
      // isAdmin() is needed for the Admin Dashboard's unfiltered swap count -
      // without it, Firestore rejects that query outright since it can't
      // verify the participants-only rule for every possible matching doc.
      allow read: if isSignedIn() && (uid() in resource.data.participants || isAdmin());
      allow create: if isSignedIn()
        && uid() in request.resource.data.participants
        && isReliableEnough();
      allow update: if isSignedIn() && uid() in resource.data.participants;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------- curated skills (admin)
    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------ gamification data
    // Points/level/badges are only ever awarded by Cloud Functions (admin SDK
    // bypasses these rules) - there is no legitimate client write path here,
    // so `isSelf()` previously let any user set their own points/badges
    // directly instead of earning them.
    match /gamification/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /progress/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);
    }

    // ---------------------------------------------------------------- forum
    match /forum_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == uid();
      allow update: if isSignedIn() && resource.data.authorId == uid();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == uid());
    }

    // ------------------------------------------------- analytics / activity
    match /analytics/{eventId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
    }

    // ------------------------------------------------ trust & safety: blocks
    match /blocks/{blockId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ----------------------------------------------- trust & safety: reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.reportedUserId != uid();
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------ feedback
    // General app feedback, always attributed to the sender. Only the
    // sender and admins may read it back; only admins may mark it reviewed.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------------- complaints
    // A specific issue filed for moderators to resolve - separate from
    // `reports` (which flags another user's behaviour).
    match /complaints/{complaintId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------- profile views
    // One doc per viewer per profile per day (id encodes all three), so
    // repeat visits don't inflate the count. Only the viewed person can read
    // who looked - viewers can't enumerate anyone's audience.
    match /profileViews/{viewId} {
      allow create: if isSignedIn()
        && request.resource.data.viewerId == uid()
        && request.resource.data.viewedUserId != uid();
      allow update: if isSignedIn()
        && resource.data.viewerId == uid()
        && request.resource.data.viewerId == uid();
      allow read: if isSignedIn() && resource.data.viewedUserId == uid();
    }

    // ------------------------------------------------------- public stats
    // Aggregate, non-identifying numbers shown before sign-in. Written only
    // by Cloud Functions (admin SDK bypasses these rules).
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
