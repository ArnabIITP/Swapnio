rules_version = '2';

// Swapnio - Firestore security rules
//
// Design goals:
//  * users are publicly discoverable, but only editable by their owner
//  * reputation (rating / completedSwaps) may only be updated by other users
//    through the rating flow, and only after a *completed* swap session
//  * chat data is only visible to the two participants
//  * curated skills, analytics and the moderation queue are admin-only
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).isAdmin == true;
    }

    function changedKeysOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function changedNoneOf(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Fields on a user's own document that only an admin (isAdmin) or a
    // Cloud Function (admin SDK - bypasses these rules) may change: trust /
    // moderation state and reputation numbers the whole no-show and rating
    // system depends on. `isSelf()` used to grant unrestricted self-write
    // access to the entire document, which meant any signed-up user could
    // set their own `isAdmin: true`, clear `isBanned`, or fabricate a
    // perfect rating/attendance record with one Firestore write. This list
    // is what closes that off while leaving normal profile edits untouched.
    function protectedUserFields() {
      // passportNumber is issued by the issuePassportNumber Cloud Function,
      // which reserves it in passportNumbers/{number} - a client-written one
      // could claim someone else's number.
      return ['isAdmin', 'isBanned', 'rating', 'ratingsCount', 'completedSwaps',
              'sessionsAttended', 'noShowCount', 'passportNumber',
              // Referral attribution and its reward - set once by the
              // claimReferral function.
              'referredBy', 'referredAt', 'boostUntil',
              // Verified status - copied from Firebase Auth by the
              // syncVerification function.
              'verified', 'emailVerified', 'phoneVerified', 'verifiedAt',
              // Google Calendar connection - set by functions/calendar.js.
              'calendarConnected',
              // Mirrors profile visibility; set by functions/privacy.js.
              'discoverable'];
    }

    // Never stored on the public profile (functions/privacy.js): the email
    // lives only in Firebase Auth, push tokens in users/{uid}/settings/push.
    function privateUserFields() {
      return ['email', 'fcmTokens'];
    }

    // Same chat-room id the app and server use: both uids, sorted.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function matchedWith(userId) {
      return exists(/databases/$(database)/documents/chatRooms/$(pairId(uid(), userId)));
    }

    // The `update` guard above doesn't cover `create` - a brand-new account's
    // very first write could otherwise set isAdmin: true directly, since
    // there's no `resource.data` yet to diff against. Every protected field
    // must be absent or at its safe starting value on creation.
    function createsWithSafeUserDefaults() {
      let data = request.resource.data;
      return (!('isAdmin' in data) || data.isAdmin == false)
        && (!('isBanned' in data) || data.isBanned == false)
        && (!('rating' in data) || data.rating == 0)
        && (!('ratingsCount' in data) || data.ratingsCount == 0)
        && (!('completedSwaps' in data) || data.completedSwaps == 0)
        && (!('sessionsAttended' in data) || data.sessionsAttended == 0)
        && (!('noShowCount' in data) || data.noShowCount == 0)
        && !data.keys().hasAny(['passportNumber', 'referredBy', 'referredAt', 'boostUntil',
                                'verified', 'emailVerified', 'phoneVerified', 'verifiedAt',
                                'calendarConnected', 'discoverable', 'email', 'fcmTokens']);
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      // Discoverability: every signed-in user can browse profiles, unless the
      // owner set profileVisibility to 'private' - self and admins can always
      // read. ('matches'-only visibility still needs a client/UI-level check
      // today; enforcing it here would require a cross-collection read on
      // every Discover-feed document and hasn't been done yet.)
      // Opening one profile honours its visibility: public for everyone,
      // 'matches' for people you have a chat with, 'private' for no one.
      allow get: if isSignedIn() && (
        isSelf(userId)
        || isAdmin()
        || resource.data.get('privacy', {}).get('profileVisibility', 'public') == 'public'
        || (resource.data.get('privacy', {}).get('profileVisibility', 'public') == 'matches'
            && matchedWith(userId)));
      // Listing (Discover, search, leaderboards) only ever returns profiles
      // marked discoverable, so a non-public profile can't be pulled in
      // bulk. Queries must filter on discoverable == true.
      allow list: if isSignedIn() && (isAdmin() || resource.data.discoverable == true);
      allow create: if isSelf(userId) && createsWithSafeUserDefaults();
      // The owner may edit their own profile fields, but not the
      // trust/reputation fields in protectedUserFields() - those are
      // admin/Cloud-Function-only. Other users may only touch the aggregate
      // reputation fields written by the rating flow (ratingsCount counts
      // received ratings; completedSwaps counts finished sessions).
      // Only the owner edits a profile, and never the protected fields.
      // Rating, ratingsCount and completedSwaps are maintained by Cloud
      // Functions from the ratings and sessions themselves - other users
      // used to be allowed to write them, which let anyone set anyone's
      // rating. Private fields may be removed but never added or changed.
      allow update: if (isSelf(userId)
          && changedNoneOf(protectedUserFields())
          && changedNoneOf(privateUserFields()))
        || isAdmin();
      allow delete: if isSelf(userId) || isAdmin();

      // Devices signed in to this account (registerDevice function). The
      // owner sees them in Settings > Security; only the server writes.
      match /devices/{deviceId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      // Two-factor secret and backup-code hashes - server only, no client
      // access at all.
      match /private/{docId} {
        allow read, write: if false;
      }

      // Per-user preferences (notifications / privacy / appearance).
      match /settings/{docId} {
        allow read, write: if isSelf(userId);
      }
    }

    // ---------------------------------------------------------- swipe requests
    match /swipeRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == uid()
        || resource.data.toUserId == uid()
        || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == uid()
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != uid();
      // The recipient may mark it (e.g. seen) but not re-address it.
      allow update: if isSignedIn() && resource.data.toUserId == uid()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;
      allow delete: if isSignedIn() && (
        resource.data.fromUserId == uid() || resource.data.toUserId == uid());
    }

    // -------------------------------------------------------------- favorites
    match /favorites/{favoriteId} {
      allow read, delete: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }

    // ---------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      // The owner reads, marks read and deletes their own. Only Cloud
      // Functions create notifications (requests, accepts, sessions,
      // ratings, security) - app-written ones could impersonate anyone,
      // including "Swapnio Support", in a push notification.
      allow read, delete: if isSignedIn() && resource.data.userId == uid();
      allow update: if isSignedIn() && resource.data.userId == uid()
        && changedKeysOnly(['read']);
      allow create: if false;
    }

    // ------------------------------------------------------ chat rooms & chat
    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && uid() in resource.data.users;
      // Rooms are opened only by the acceptSwapRequest function, after a
      // request was accepted - never directly, which is what stopped
      // strangers messaging people without a match.
      allow create: if false;
      // Participants update the room (last message, unread counts, typing,
      // unmatch) but can't change who is in it.
      allow update: if isSignedIn() && uid() in resource.data.users
        && changedNoneOf(['users', 'userNames', 'userPhotos'])
        // Any change to the last-message preview must be credited to you,
        // so it can't be made to look like the other person wrote it.
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['lastMessage', 'lastMessageSenderId', 'lastMessageTime'])
            || request.resource.data.lastMessageSenderId == uid());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.users;
        allow create: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.users
          && request.resource.data.senderId == uid()
          // 'system' notices and session cards come from the server only.
          && !(request.resource.data.get('type', 'text') in ['system', 'session', 'rating']);
        // Participants may react to messages, but only touch the reactions
        // map - the text, sender and timestamp stay immutable.
        allow update: if isAdmin() || (isSignedIn()
          && uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.users
          && changedKeysOnly(['reactions']));
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------- ratings / swap reviews
    // One rating per person per session, written by the server.
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      // Ratings are given per session through the rateSession function
      // (after both people confirm it) - never written from the app.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------- swap sessions
    match /swaps/{swapId} {
      // isAdmin() is needed for the Admin Dashboard's unfiltered swap count -
      // without it, Firestore rejects that query outright since it can't
      // verify the participants-only rule for every possible matching doc.
      allow read: if isSignedIn() && (uid() in resource.data.participants || isAdmin());
      // Proposing, accepting, declining, cancelling and rescheduling go
      // through Cloud Functions (functions/schedule.js) so every change is
      // checked against both people's calendars; checking in and completing
      // go through functions/sessions.js, which enforce both check-ins and
      // the minimum length. The only direct write left is reporting that an
      // accepted session never happened.
      allow create: if false;
      allow update: if isSignedIn()
        && uid() in resource.data.participants
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'no_show'
        && resource.data.get('startedAt', null) == null
        && request.resource.data.get('noShowReportedBy', null) == uid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'noShowReportedBy', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------- curated skills (admin)
    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // "Connect your calendar" nudge bookkeeping - server only.
    match /calendarNudges/{id} {
      allow read, write: if false;
    }

    // Automatic flags for admins (e.g. frequent cancellations).
    match /adminFlags/{flagId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Security log - written only by Cloud Functions, 90-day retention.
    match /securityEvents/{eventId} {
      allow read: if isSignedIn() && (resource.data.uid == uid() || isAdmin());
      allow write: if false;
    }


    // Referral records - created and qualified only by Cloud Functions;
    // readable by the two people involved.
    match /referrals/{refereeId} {
      allow read: if isSignedIn()
        && (resource.data.referrerId == uid() || resource.data.refereeId == uid() || isAdmin());
      allow write: if false;
    }

    // Catalog version marker, written by the syncSkillCatalog function.
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Requests for skills that aren't in the catalog yet - filed and resolved
    // only through the requestSkill / resolveSkillRequest functions.
    match /skillRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------ gamification data
    // Points/level/badges are only ever awarded by Cloud Functions (admin SDK
    // bypasses these rules) - there is no legitimate client write path here,
    // so `isSelf()` previously let any user set their own points/badges
    // directly instead of earning them.
    match /gamification/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /progress/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);
    }

    // ---------------------------------------------------------------- forum
    match /forum_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == uid();
      allow update: if isSignedIn() && resource.data.authorId == uid()
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == uid());
    }

    // ------------------------------------------------- analytics / activity
    match /analytics/{eventId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
    }

    // ------------------------------------------------ trust & safety: blocks
    match /blocks/{blockId} {
      // Only the blocker and the blocked person can see a block (the app
      // hides people in both directions); nobody else can.
      allow read: if isSignedIn()
        && (resource.data.userId == uid() || resource.data.blockedUserId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ----------------------------------------------- trust & safety: reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.reportedUserId != uid();
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------ feedback
    // General app feedback, always attributed to the sender. Only the
    // sender and admins may read it back; only admins may mark it reviewed.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------------- complaints
    // A specific issue filed for moderators to resolve - separate from
    // `reports` (which flags another user's behaviour).
    match /complaints/{complaintId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------- profile views
    // One doc per viewer per profile per day (id encodes all three), so
    // repeat visits don't inflate the count. Only the viewed person can read
    // who looked - viewers can't enumerate anyone's audience.
    match /profileViews/{viewId} {
      allow create: if isSignedIn()
        && request.resource.data.viewerId == uid()
        && request.resource.data.viewedUserId != uid();
      allow update: if isSignedIn()
        && resource.data.viewerId == uid()
        && request.resource.data.viewerId == uid();
      allow read: if isSignedIn() && resource.data.viewedUserId == uid();
    }

    // ------------------------------------------------------- public stats
    // Aggregate, non-identifying numbers shown before sign-in. Written only
    // by Cloud Functions (admin SDK bypasses these rules).
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
